# @vinext/cloudflare declares a `vinext: >=0.0.0` peer range, which npm semver
# refuses to match against the prerelease `vinext@1.0.0-beta.3` we depend on.
# The packages are compatible; only the range notation excludes prereleases.
# Set here rather than on the command line so CI `npm ci` resolves identically.
legacy-peer-deps=true
